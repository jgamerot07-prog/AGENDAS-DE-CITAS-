# Copia este archivo como .env y ajusta los valores
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agenda
DATABASE_SSL=false
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Hora local del negocio y tamaño de los bloques de la agenda
BUSINESS_UTC_OFFSET=-05:00
SLOT_MINUTES=30
MAX_DAYS_AHEAD=60

# Usuario administrador que se crea con "npm run seed"
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@agendapro.com
ADMIN_PASSWORD=Admin123*

# true = aplica migraciones y datos iniciales al arrancar (útil en Render)
RUN_MIGRATIONS=false
